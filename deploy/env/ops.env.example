# Settings for the ops scripts (backup, restore, migrate, preflight) → /etc/rokh/ops.env
# (root:root, chmod 600). No secrets here. Variables already set in the environment win.
# Override the file location with ROKH_OPS_ENV=/path/to/ops.env.

# Files written by the operator (deploy/README.md §2).
ROKH_BIN=/opt/rokh/bin/rokh
ROKH_ENV_FILE=/etc/rokh/rokh.env
ROKH_MIGRATE_ENV_FILE=/etc/rokh/migrate.env
# Compose variables of the PostgreSQL container (ROKH_PG_PORT, ROKH_PG_IMAGE), checked by preflight.sh.
ROKH_COMPOSE_ENV_FILE=/opt/rokh/postgres/.env
# When the scripts run as root, the rokh binary itself runs as this user (runuser).
ROKH_RUN_AS=rokh

# How pg_dump / pg_restore / psql are run:
#   docker — inside the dedicated container (exact server version, no host client needed)
#   host   — client tools on PATH (must be version >= the server)
PG_CLIENT=docker
PG_CONTAINER=rokh-postgres

# Backups go to the separately mounted backup disk, never the (nearly full) root filesystem.
# BACKUP_DIR must already exist; the script never creates it.
BACKUP_DIR=/backup/rokh
# Refuse to run unless BACKUP_DIR is on this mount point (protects against /backup not mounted).
BACKUP_REQUIRE_MOUNT=/backup
# Refuse to start with less free space than this on the backup disk. /backup is SHARED with the
# server's other backups, so the reserve protects them, not Rokh (Rokh's sets are small): about
# 10 % of the 825 GB /backup filesystem observed in LRA-2 = 84480 MB. Recompute it if the mount
# changes, and raise it if the host's own alert threshold is stricter (deploy/README.md §8.2).
BACKUP_MIN_FREE_MB=84480
# Retention: remove complete Rokh sets older than KEEP_DAYS, always keeping the newest KEEP_MIN
# complete sets; incomplete sets are never removed (deploy/README.md §8.3).
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=7

# Scheduled backups (backup-cron.sh) record every run here (root filesystem, root 0700, tiny);
# backup-status.sh alerts when the last run failed or the last success is older than MAX_AGE.
BACKUP_STATUS_DIR=/var/lib/rokh-backup
BACKUP_MAX_AGE_HOURS=26
