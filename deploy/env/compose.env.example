# Docker Compose variables for deploy/postgres/compose.yaml → /opt/rokh/postgres/.env
# (root:root, chmod 600), next to compose.yaml. Compose reads this file itself when it runs on
# /opt/rokh/postgres/compose.yaml (the project directory). A variable exported in the calling shell
# OVERRIDES this file: never export ROKH_PG_* in root's shell or profile, and check
# `docker compose config` before every `up` (deploy/README.md §4.1).
# No secrets here, and nothing here reaches the container (that is postgres.env).
# preflight.sh checks both values (ops.env: ROKH_COMPOSE_ENV_FILE).

# Loopback port published for PostgreSQL. There is no default: Compose refuses to start without it.
# 15433 is a PROPOSED value (LRA-2), not reserved and not approved: confirm it is free right before
# the first start (deploy/README.md §3 step 4). 127.0.0.1:15432 is used by an unrelated service on
# the target server. DATABASE_URL (rokh.env) and MIGRATION_DATABASE_URL (migrate.env) must use the
# same port.
ROKH_PG_PORT=15433

# Exact image, pinned by digest (deploy/README.md §4.1). Replace CHANGE_ME with the 64-hex digest
# recorded at the first pull; preflight.sh refuses an image that is not pinned.
ROKH_PG_IMAGE=postgres:16-bookworm@sha256:CHANGE_ME
