# First-initialisation settings for deploy/postgres/compose.yaml → /etc/rokh/postgres.env
# (root:root, chmod 600). Read by `docker compose` only. Placeholders: never commit real values.
# Generate each password with: openssl rand -hex 24   (hex: no URL encoding needed)
# PostgreSQL reads these only when the data volume is created; changing them later has no effect
# (change a role password with ALTER ROLE, then update rokh.env / migrate.env).

# Superuser inside the container: used only for creating restore targets and upgrades.
POSTGRES_PASSWORD=CHANGE_ME
ROKH_DB_NAME=rokhtiacafe
# Must match the passwords in /etc/rokh/migrate.env and /etc/rokh/rokh.env.
ROKH_OWNER_PASSWORD=CHANGE_ME
ROKH_APP_PASSWORD=CHANGE_ME
