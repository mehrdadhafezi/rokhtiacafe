# Runtime settings for `rokh serve` → /etc/rokh/rokh.env (root:rokh, chmod 640).
# Loaded by systemd (EnvironmentFile=) and read by the ops scripts; never `source` it in a shell.
# Placeholders only: never commit real values. Validate with: deploy/scripts/preflight.sh
# Format: KEY=VALUE, one per line, no quotes needed, no spaces around "=".

APP_ENV=production
# Loopback only. LiteSpeed (cPanel userdata include) proxies rokh.tiacafe.ir to this address.
HTTP_ADDR=127.0.0.1:18080
APP_BASE_URL=https://rokh.tiacafe.ir
# The direct peer as rokh sees it is LiteSpeed on loopback. Add the MizbanCloud edge ranges only
# after the forwarding chain is verified (docs/HOSTING-ASSESSMENT.md §3, risk R1).
TRUSTED_PROXIES=127.0.0.1
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s

# DML-only runtime role. The rokh_owner credentials live in /etc/rokh/migrate.env only.
# Port = the loopback port published by deploy/postgres/compose.yaml (ROKH_PG_PORT).
# Use a password of [A-Za-z0-9] only (e.g. openssl rand -hex 24), or percent-encode it.
DATABASE_URL=postgres://rokh_app:CHANGE_ME@127.0.0.1:15432/rokhtiacafe?sslmode=disable

# Secret (base64, 32+ bytes): rokh secret gen. Changing it invalidates customer tracking links.
APP_SECRET_KEY=

# Absolute, persistent, outside any web root; writable by the rokh user only.
UPLOAD_DIR=/var/lib/rokh/uploads

ORDERING_HOURS=08:00-23:00
ORDER_PENDING_TTL=20m
ORDER_MAX_PENDING=40
ORDER_MAX_PENDING_PER_CLIENT=15

SESSION_IDLE_TIMEOUT=12h
SESSION_MAX_AGE=168h

# Web Push (optional): rokh vapid gen. Leave both keys empty to keep push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ME@tiacafe.ir
PUSH_HOST_ALLOWLIST=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
