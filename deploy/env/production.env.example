# Production runtime settings → copy to ~/rokh/.env, fill in, chmod 600.
# Placeholders only: never commit real values. Check with: bin/rokh config check

APP_ENV=production
# Loopback only: the reverse proxy (Caddy / host proxy) terminates TLS in front of it.
HTTP_ADDR=127.0.0.1:8080
APP_BASE_URL=https://rokh.tiacafe.ir
# The proxy's address as seen by rokh, so rate limits use the real client IP.
TRUSTED_PROXIES=127.0.0.1
APP_TIMEZONE=Asia/Tehran
LOG_LEVEL=info
LOG_FORMAT=json
SHUTDOWN_TIMEOUT=15s

# DML-only runtime role (rokh_app). The owner role belongs in .env.migrate only.
DATABASE_URL=postgres://rokh_app:CHANGE_ME@127.0.0.1:5432/rokhtiacafe?sslmode=disable

# Secret (base64, 32+ bytes): bin/rokh secret gen. Changing it invalidates customer tracking links.
APP_SECRET_KEY=

# Absolute path outside any public web root.
UPLOAD_DIR=/home/CHANGE_ME/rokh/uploads

ORDERING_HOURS=08:00-23:00
ORDER_PENDING_TTL=20m
ORDER_MAX_PENDING=40
ORDER_MAX_PENDING_PER_CLIENT=15

SESSION_IDLE_TIMEOUT=12h
SESSION_MAX_AGE=168h

# Web Push (optional): bin/rokh vapid gen. Leave both keys empty to keep push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CHANGE_ME@tiacafe.ir
PUSH_HOST_ALLOWLIST=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
