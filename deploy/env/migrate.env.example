# Schema-owner connection → /etc/rokh/migrate.env (root:root, chmod 600).
# Used only by deploy/scripts/{migrate,backup,restore,preflight}.sh. Never put it in rokh.env: the
# running server must not hold owner credentials (docs/SECURITY.md §9).
# Same host/port/database as DATABASE_URL in rokh.env (port = ROKH_PG_PORT in /opt/rokh/postgres/.env);
# password of [A-Za-z0-9] only, or percent-encoded.
MIGRATION_DATABASE_URL=postgres://rokh_owner:CHANGE_ME@127.0.0.1:15433/rokhtiacafe?sslmode=disable
