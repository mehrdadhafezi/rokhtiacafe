# VPS option (deploy/README.md §4): Caddy obtains and renews the TLS certificate and proxies to
# rokh on loopback. Set TRUSTED_PROXIES=127.0.0.1 in ~/rokh/.env.
rokh.tiacafe.ir {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
	request_body {
		# Largest request: product image upload (3 MB) plus multipart overhead.
		max_size 4MB
	}
}
