# cPanel option — use ONLY if the hosting assessment (docs/HOSTING-ASSESSMENT.md, item 4)
# confirmed the host allows proxying to a localhost port through .htaccess.
# Goes in the document root of the rokh.tiacafe.ir subdomain; rokh listens on 127.0.0.1:8080.
# Keep TRUSTED_PROXIES=127.0.0.1 in ~/rokh/.env so the real client IP is used.

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^(.*)$ http://127.0.0.1:8080/$1 [P,L]
