# Copy to .env and fill in real values locally. NEVER commit .env.
# Placeholders only — no real secrets in this file.

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:5173
HTTP_ADDR=127.0.0.1:8080
APP_TIMEZONE=Asia/Tehran
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty in dev)
TRUSTED_PROXIES=

# --- Database (local only; never expose PostgreSQL publicly) ---
DATABASE_URL=postgres://rokh:change-me@127.0.0.1:5432/rokhtiacafe?sslmode=disable

# --- Sessions ---
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=12h
SESSION_MAX_AGE=168h

# --- Ordering ---
ORDERING_HOURS=08:00-23:00
ORDER_PENDING_TTL=20m
ORDER_MAX_PENDING=40

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Web Push (generate with: rokh vapid gen) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
