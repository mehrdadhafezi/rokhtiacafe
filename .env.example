# Copy to .env for local development. NEVER commit .env.
# Values below are local development defaults only (they match docker-compose.yml).
# Production credentials are different and live only in the server's own .env files.

# --- App ---
APP_ENV=development
LOG_LEVEL=info
# LOG_FORMAT=text   # text (default in dev) or json (default in production)
SHUTDOWN_TIMEOUT=15s
# Origin of the page that calls the API; must match the Vite dev server (scripts/dev.ps1 fe-dev).
APP_BASE_URL=http://127.0.0.1:5173
HTTP_ADDR=127.0.0.1:8080
APP_TIMEZONE=Asia/Tehran
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty in dev)
TRUSTED_PROXIES=

# --- Database (local only; never expose PostgreSQL publicly) ---
# Local Docker PostgreSQL listens on 127.0.0.1:55432 (see docker-compose.yml).
# Runtime role (DML only)
DATABASE_URL=postgres://rokh_app:app_dev_only@127.0.0.1:55432/rokhtiacafe?sslmode=disable
# Migration role (schema owner) — used only by `rokh migrate`; keep out of the service environment in production
MIGRATION_DATABASE_URL=postgres://rokh_owner:owner_dev_only@127.0.0.1:55432/rokhtiacafe?sslmode=disable
# Superuser connection used ONLY by integration tests to create/drop throwaway databases
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_only@127.0.0.1:55432/postgres?sslmode=disable

# --- Secrets ---
# 32+ random bytes, base64. Derives tracking tokens and client keys. Generate: rokh secret gen
APP_SECRET_KEY=

# --- Sessions ---
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=12h
SESSION_MAX_AGE=168h

# --- Ordering ---
ORDERING_HOURS=08:00-23:00
ORDER_PENDING_TTL=20m
ORDER_MAX_PENDING=40
ORDER_MAX_PENDING_PER_CLIENT=15

# --- Uploads ---
UPLOAD_DIR=./data/uploads

# --- Web Push (optional; disabled while the keys are empty) ---
# Generate the pair with `rokh vapid gen`. The private key is a secret: server .env only.
# VAPID_SUBJECT is the contact push services can reach (mailto: or https://).
# PUSH_HOST_ALLOWLIST: push-service hosts the server may call; a leading "." allows subdomains.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_HOST_ALLOWLIST=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
